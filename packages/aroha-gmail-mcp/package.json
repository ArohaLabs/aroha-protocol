{
  "name": "@aroha-sdk/gmail-mcp",
  "version": "0.1.1",
  "description": "MCP server for Gmail over the ordinary Gmail API — search, read, label and draft, without the preview-gated Google MCP endpoint",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "aroha-gmail-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "aroha",
    "mcp",
    "gmail",
    "agent",
    "ai"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ArohaLabs/aroha-protocol/tree/main/packages/aroha-gmail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArohaLabs/aroha-protocol.git",
    "directory": "packages/aroha-gmail-mcp"
  },
  "bugs": {
    "url": "https://github.com/ArohaLabs/aroha-protocol/issues"
  },
  "files": [
    "dist",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ]
}
