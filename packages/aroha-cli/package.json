{
  "name": "@aroha-sdk/cli",
  "version": "1.3.0",
  "description": "CLI for scaffolding Aroha agents and converting from other agentic protocols (A2A, Agntcy, MCP, LangChain)",
  "type": "module",
  "bin": {
    "aroha": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./commands/init": "./dist/commands/init.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0",
    "@aroha-sdk/registry": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/ArohaLabs/aroha-protocol/tree/main/packages/aroha-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArohaLabs/aroha-protocol.git",
    "directory": "packages/aroha-cli"
  },
  "bugs": {
    "url": "https://github.com/ArohaLabs/aroha-protocol/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
