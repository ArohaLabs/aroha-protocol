{
  "name": "@aroha-sdk/trust",
  "version": "0.1.1",
  "description": "Aroha caller-uniqueness layer — KYC issuer trust and Chaum-Pedersen nullifier proofs for Sybil-resistant reputation",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.3",
    "@types/node": "^20.14.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/ArohaLabs/aroha-protocol/tree/main/packages/aroha-trust#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArohaLabs/aroha-protocol.git",
    "directory": "packages/aroha-trust"
  },
  "bugs": {
    "url": "https://github.com/ArohaLabs/aroha-protocol/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
