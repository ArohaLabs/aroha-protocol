{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": false
  },
  "include": ["src/**/*"],
  // Tests are excluded from the BUILD so they are not shipped to consumers —
  // they were previously compiled into dist/ and published. They are still
  // typechecked, via tsconfig.typecheck.json.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
