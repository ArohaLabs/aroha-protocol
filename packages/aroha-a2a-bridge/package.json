{
  "name": "@aroha-sdk/a2a-bridge",
  "version": "2.0.0",
  "description": "Aroha ↔ A2A 1.0 (Agent2Agent protocol, Linux Foundation) adapter: message mapping, JSON-RPC client, mandate carriage",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
