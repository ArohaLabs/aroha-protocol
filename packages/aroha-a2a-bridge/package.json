  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0"
  },
  "devDependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@types/node": "^20.14.0",
    "express": "^4.22.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
