{
  "name": "@aroha-sdk/evals",
  "version": "1.2.3",
  "description": "Evaluation harness for Aroha agents — golden-dataset runner, LLM-as-judge, trajectory scoring",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aroha-evals": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/ArohaLabs/aroha-protocol/tree/main/packages/aroha-evals#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArohaLabs/aroha-protocol.git",
    "directory": "packages/aroha-evals"
  },
  "bugs": {
    "url": "https://github.com/ArohaLabs/aroha-protocol/issues"
  },
  "keywords": [
    "aroha",
    "agent",
    "evals",
    "llm-as-judge",
    "evaluation"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@types/node": "^20.14.0"
  }
}
