{
  "name": "@aroha/registry-server",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/migrate.mjs --check --remote && wrangler deploy",
    "deploy:force": "wrangler deploy",
    "test": "vitest run",
    "db:create": "wrangler d1 create aroha-registry",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "db:check": "node scripts/migrate.mjs --check",
    "db:check:remote": "node scripts/migrate.mjs --check --remote"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0",
    "@aroha-sdk/credentials": "^2.0.0",
    "@aroha-sdk/registry": "^2.0.0",
    "@aroha-sdk/trust": "^0.1.1",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
