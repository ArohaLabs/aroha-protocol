{
  "name": "@aroha-sdk/mcp-server",
  "version": "2.0.0",
  "description": "MCP server for the Aroha registry — stdio and remote (Streamable HTTP + OAuth) connector for Claude, Muse, ChatGPT and any MCP client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "aroha-mcp-server": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0",
    "@aroha-sdk/credentials": "^2.0.0",
    "@aroha-sdk/registry": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "jose": "^6.2.3",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "aroha",
    "mcp",
    "agent",
    "ai"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ArohaLabs/aroha-protocol/tree/main/packages/aroha-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArohaLabs/aroha-protocol.git",
    "directory": "packages/aroha-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/ArohaLabs/aroha-protocol/issues"
  },
  "files": [
    "dist",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ]
}
