{
  "name": "@aroha-sdk/chaos",
  "version": "1.2.2",
  "description": "Chaos engineering utilities for Aroha sagas: fault injection, compensation path testing",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.3",
    "@types/node": "^20.14.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
