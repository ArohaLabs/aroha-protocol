{
  "name": "@aroha-sdk/telemetry",
  "version": "1.2.3",
  "description": "Aroha distributed tracing — W3C Trace Context propagation for multi-agent sagas",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.3",
    "@types/node": "^20.14.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opentelemetry/api": "*"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
