{
  "name": "@aroha-sdk/langchain-bridge",
  "version": "2.0.0",
  "description": "Aroha ↔ LangChain bridge and OpenAI function tools — use Aroha as transport for any agent framework",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.test.*",
    "!**/test-utils/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aroha-sdk/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openai": "^7.39.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
