{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aroha-labs.com/schemas/disclosure-v1.json",
  "title": "ArohaDisclosure (aroha-1.0 §12.7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "agentDid", "principalDid", "principalKind", "purpose", "hop", "aiGenerated"],
  "properties": {
    "v": { "const": 1 },
    "agentDid": { "type": "string", "pattern": "^did:" },
    "principalDid": { "type": "string", "pattern": "^did:" },
    "principalKind": { "enum": ["person", "organization"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "hop": { "type": "integer", "minimum": 0 },
    "aiGenerated": { "const": true }
  }
}
