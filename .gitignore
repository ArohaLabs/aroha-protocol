# LaTeX build artifacts
papers/*.aux
papers/*.bbl
papers/*.blg
papers/*.log
papers/*.out
papers/*.pdf
papers/pdf/*.aux
papers/pdf/*.bbl
papers/pdf/*.blg
papers/pdf/*.log
